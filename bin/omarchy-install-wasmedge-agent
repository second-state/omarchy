#!/bin/bash

# omarchy:summary=Install WasmEdge Agent as a lazy launcher in ~/.local/bin
# omarchy:args=[--check|--now|--owns]
# omarchy:examples=omarchy install wasmedge agent | omarchy install wasmedge agent --now
# omarchy:requires-sudo=true

# WasmEdge Agent is not a mise tool and not a pacman package. Its own release
# installer provisions the whole runtime -- WasmEdge, the wasm32-wasip1 Rust
# target, the agent, and the cell workspace the agent compiles into -- and stays
# the only authority on it. This command owns nothing but the launcher it writes
# and the question of who wrote it.
#
# The launcher exists so a fresh Omarchy resolves wasmedge-agent before the agent
# is installed, without the agent binary entering the ISO. Omarchy puts
# ~/.local/share/mise/shims ahead of ~/.local/bin on PATH, so once the install
# finishes and reshims, the shim precedes the launcher and the launcher stops
# being reached at all. It goes dormant rather than being deleted, and it is
# still there if the agent is later removed.

set -euo pipefail

mode=${1:-}

launcher="$HOME/.local/bin/wasmedge-agent"

# Where the launcher waits out an install that needs its own path. A sibling, so
# moving it is a rename inside one directory and cannot fail across file
# systems, and hidden, so nothing resolves wasmedge-agent through it.
launcher_aside="$HOME/.local/bin/.wasmedge-agent.omarchy-aside"

install_log="$HOME/.local/state/omarchy/wasmedge-agent-install.log"

# Records the command an install of this command's left at the launcher path
# when it could not finish. Written only once npm has published that command,
# and removed once the runtime answers ready, so what survives a failure names
# the one link a retry may reclaim. An install that failed before npm published
# anything leaves nothing behind, and so claims nothing.
install_pending="$HOME/.local/state/omarchy/wasmedge-agent-install.pending"

# The line that identifies the launcher as this command's; matched whole, so a
# wrapper that merely mentions the command is not mistaken for ours.
marker='# Written by omarchy-install-wasmedge-agent.'

# The name the agent is published under, which is also the directory npm gives it
# in the global module tree and the command it links into the global bin
# directory. Used to tell npm's command for this package from npm's command for
# any other one.
npm_package='wasmedge-agent'

# Overridable so the tests and a clean-guest validation can point at a local
# mirror: the release repository is private, and GitHub does not serve a private
# repository's assets anonymously.
installer_url=${OMARCHY_WASMEDGE_AGENT_INSTALLER_URL:-https://github.com/second-state/wasmedge-agent/releases/latest/download/install.sh}

# The first wasmedge-agent on PATH that is not the launcher, then the global npm
# prefix, which covers the window between the package install and the reshim that
# gives it a mise shim. Prints the path that answered, so a caller can say which
# binary it found.
#
# The launcher carries the same rule inline. It has to work when this command is
# absent or broken, so the duplication is deliberate, and the shell tests assert
# that the two agree.
real_agent() {
  local candidate prefix

  while IFS= read -r candidate; do
    [[ -f $candidate && -x $candidate ]] || continue
    if grep -qxF "$marker" "$candidate" 2>/dev/null; then
      continue
    fi
    printf '%s\n' "$candidate"
    return 0
  done < <(type -aP wasmedge-agent 2>/dev/null)

  prefix=$(npm prefix -g 2>/dev/null) || return 1
  [[ -n $prefix && -f $prefix/bin/wasmedge-agent && -x $prefix/bin/wasmedge-agent ]] || return 1
  # The whole-line marker test the PATH candidates get, for the same reason. When
  # npm's global prefix is ~/.local -- the ordinary way to avoid sudo npm -- this
  # candidate is the launcher, and answering with it makes the launcher exec
  # itself forever.
  if grep -qxF "$marker" "$prefix/bin/wasmedge-agent" 2>/dev/null; then
    return 1
  fi
  printf '%s\n' "$prefix/bin/wasmedge-agent"
}

# Whether the runtime is ready, which is what the default agent asks before it
# opens the TUI. Reads only. The cold launcher is never run: real_agent skips it,
# and running it would start a minutes-long install from inside a question.
runtime_ready() {
  local agent report

  agent=$(real_agent) || return 1
  timeout 15 "$agent" --version >/dev/null 2>&1 || return 1
  report=$(timeout 30 "$agent" doctor --json 2>/dev/null) || return 1

  # Read out of the report rather than from the exit status: doctor reports and
  # exits 0 whatever it finds, and doctor --fix is the mode that repairs, which is
  # the one thing this must not do. An empty runtime array means nothing was
  # checked, which is not the same as healthy.
  printf '%s' "$report" |
    jq -e '(.runtime | type) == "array" and (.runtime | length) > 0 and all(.runtime[]; .ok == true)' >/dev/null 2>&1
}

# Whether the file at a path is a launcher this command wrote. Asked of the
# launcher path, and of the paths a launcher is moved to while the path it came
# from is worked on. A link is somebody else's arrangement even when it resolves
# to a marked file, because the launcher is written as a regular file.
omarchy_wrote() {
  [[ -f $1 && ! -L $1 ]] && grep -qxF "$marker" "$1" 2>/dev/null
}

# The launcher is the only thing this command owns. Anything else at that path --
# another installer's wrapper, a hand-rolled script, a symbolic link, even a
# dangling one -- was put there by the user and is never written over or removed.
omarchy_owns_launcher() {
  omarchy_wrote "$launcher"
}

foreign_launcher() {
  [[ -e $launcher || -L $launcher ]] && ! omarchy_owns_launcher
}

# The launcher body carries the resolution rule from real_agent inline. `set -e`
# is deliberately absent: the resolution probes fail as a normal part of their
# work, and the launcher's job is to hand over to the agent, not to abort.
#
# Printed rather than written, so write_launcher decides where it lands and can
# put it in place atomically.
launcher_body() {
  cat <<EOF
#!/bin/bash

$marker

# Omarchy writes this file at provision time so wasmedge-agent resolves before
# the agent exists. The first run installs the runtime and hands over to it.
# Afterwards the mise shim precedes this file on PATH and it is no longer
# reached. The resolution rule is the one in omarchy-install-wasmedge-agent,
# inline so this file still works when that command is absent.

set -uo pipefail

wasmedge_agent_marker='$marker'

wasmedge_agent_real() {
  local candidate prefix

  while IFS= read -r candidate; do
    [[ -f \$candidate && -x \$candidate ]] || continue
    if grep -qxF "\$wasmedge_agent_marker" "\$candidate" 2>/dev/null; then
      continue
    fi
    printf '%s\n' "\$candidate"
    return 0
  done < <(type -aP wasmedge-agent 2>/dev/null)

  prefix=\$(npm prefix -g 2>/dev/null) || return 1
  [[ -n \$prefix && -f \$prefix/bin/wasmedge-agent && -x \$prefix/bin/wasmedge-agent ]] || return 1
  # The whole-line marker test the PATH candidates get, for the same reason. When
  # npm's global prefix is ~/.local -- the ordinary way to avoid sudo npm -- this
  # candidate is the launcher, and answering with it makes the launcher exec
  # itself forever.
  if grep -qxF "\$wasmedge_agent_marker" "\$prefix/bin/wasmedge-agent" 2>/dev/null; then
    return 1
  fi
  printf '%s\n' "\$prefix/bin/wasmedge-agent"
}

agent=\$(wasmedge_agent_real) || agent=

if [[ -z \$agent ]]; then
  # The agent's own installer ends by resolving wasmedge-agent and running
  # doctor --fix on what it finds, which on a fresh machine is this file. The
  # sentinel is how this tells "run me" from "you are already inside my own
  # install", so a resolution that comes up empty in there reports it rather
  # than starting a second install on top of the first.
  if [[ -n \${OMARCHY_WASMEDGE_AGENT_INSTALLING:-} ]]; then
    echo "wasmedge-agent was called from inside its own install, and no agent is installed yet." >&2
    echo "Not starting another install. The log is at ~/.local/state/omarchy/wasmedge-agent-install.log" >&2
    exit 1
  fi

  echo "Installing WasmEdge Agent (this takes a few minutes)..." >&2
  if ! omarchy-install-wasmedge-agent --now >&2; then
    exit 1
  fi
  agent=\$(wasmedge_agent_real) || agent=
fi

# An install that reports success and still resolves nothing is a failure, not a
# reason to run an empty command name.
if [[ -z \$agent ]]; then
  echo "WasmEdge Agent installed, and no wasmedge-agent was found on PATH or in the global npm prefix." >&2
  exit 1
fi

exec "\$agent" "\$@"
EOF
}

# Written to a sibling temporary file and renamed into place, because a rename
# inside a directory is atomic. Nothing can then leave a half-written file at
# the launcher path: such a file carries no marker, so every later run reads it
# as somebody else's, exits 0, and never repairs it, and this command offers
# nothing that recovers from that.
write_launcher() {
  local dir tmp displaced

  dir=$(dirname "$launcher")
  mkdir -p "$dir"

  tmp=$(mktemp "$dir/.wasmedge-agent.XXXXXX") || return 1

  # mktemp creates the file at 0600, and the launcher is an ordinary executable
  # in the user's own bin directory, so give it the mode it had when the body
  # was written straight to the live path.
  if ! launcher_body >"$tmp" || ! chmod 755 "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi

  # Creating the launcher and finding out whether the path was free have to be
  # one operation. A test followed by a rename is not: the ownership test that
  # allowed this write ran before the body existed, a rename replaces whatever
  # it lands on, and a user's own installer that creates the command in the
  # window between the two loses it. link() leaves no such window. It refuses
  # when the destination exists, and it refuses in the kernel.
  # EEXIST is an ordinary answer here, not a fault worth printing.
  if ln -- "$tmp" "$launcher" 2>/dev/null; then
    rm -f -- "$tmp"
    return 0
  fi

  # The path is occupied. Replacing our own launcher is how one that lost its
  # mode or its body gets repaired -- but the test that permits it stands before
  # the replacement, and a rename onto the path would destroy whatever it found
  # there, including a user's own command that took the path in between. So move
  # what is there off the path first and identify it afterwards. What the window
  # costs is then a file displaced, which is recoverable, and never a file
  # deleted, which is not.
  if omarchy_owns_launcher; then
    if ! displaced=$(mktemp "$dir/.wasmedge-agent.XXXXXX"); then
      rm -f -- "$tmp"
      return 1
    fi

    if ! mv -fT -- "$launcher" "$displaced"; then
      rm -f -- "$tmp" "$displaced"
      return 1
    fi

    # What was moved is a launcher of ours, and the path it left is still free.
    # The new body goes in through the same link() that publishes everywhere
    # else, so a file that arrived while the path stood empty is not replaced.
    if omarchy_wrote "$displaced" && ln -- "$tmp" "$launcher" 2>/dev/null; then
      rm -f -- "$tmp" "$displaced"
      return 0
    fi

    # Either what was moved was not ours after all, or the path was taken while
    # it stood empty. Both are answered by putting back what was moved, and
    # neither leaves this command's launcher at a path that is not its to take.
    rm -f -- "$tmp"
    restore_displaced "$displaced" || return 1
    return 0
  fi

  rm -f -- "$tmp"

  # Somebody else's file, which stays. An unoccupied path here is link() failing
  # for its own reasons, and that is this function failing.
  if [[ -e $launcher || -L $launcher ]]; then
    return 0
  fi
  return 1
}

# Where npm creates its global commands. `npm prefix -g` can answer a path that
# reaches its directory through symbolic links, so canonicalise it -- -m because
# the directory need not exist yet. A plain string compare against the
# launcher's own directory would miss a collision that is real.
npm_bin_dir() {
  local prefix

  prefix=$(npm prefix -g 2>/dev/null) || return 1
  [[ -n $prefix ]] || return 1
  realpath -m -- "$prefix/bin"
}

# Whether npm would create its wasmedge-agent at the launcher's own path. On a
# machine whose global prefix is ~/.local -- `npm config set prefix ~/.local`,
# the ordinary way to avoid sudo npm -- it would, and npm refuses to create its
# command over a file it did not create: it reports EEXIST and exits 1. There
# the launcher is what makes the install fail.
npm_wants_launcher_path() {
  local npm_dir launcher_dir

  npm_dir=$(npm_bin_dir) || return 1
  launcher_dir=$(realpath -m -- "$(dirname "$launcher")") || return 1
  [[ $npm_dir == "$launcher_dir" ]]
}

# Whether the launcher's path holds the command npm created for the agent's own
# package rather than a file the user put there. npm publishes a global command
# as a symbolic link into its own module tree, so a path that resolves inside
# that tree is npm's work and nobody's hand-rolled wrapper. Only ever true when
# npm's global prefix is the launcher's own directory, which is the one
# arrangement where npm's command and the launcher want the same path.
npm_owns_launcher() {
  local prefix module target

  npm_wants_launcher_path || return 1
  [[ -L $launcher ]] || return 1

  prefix=$(npm prefix -g 2>/dev/null) || return 1
  [[ -n $prefix ]] || return 1
  # The agent's own package directory, and not the module tree around it: npm
  # creates a command for every package that asks for one, and a link into some
  # other package's directory is that package's command. It is no more this
  # command's than a hand-rolled wrapper is, and reading it as ours starts an
  # install that npm can only end with EEXIST.
  module=$(realpath -m -- "$prefix/lib/node_modules/$npm_package") || return 1

  # Resolves the link. A dangling one answers nothing and stays foreign: it runs
  # nothing, so calling it an installed agent would be a lie.
  target=$(realpath -- "$launcher" 2>/dev/null) || return 1
  [[ $target == "$module"/* ]]
}

# What identifies the command npm published: the link itself, and not what it
# resolves to. Every install of the package leaves a link naming the same
# target, so the target alone tells two of them apart no better than the path
# does. The link's own inode and timestamp do, and stat reads the link rather
# than following it.
#
# Seconds since the epoch rather than a rendered time: the same instant renders
# differently in another timezone, and a record written before a machine changed
# zones would name a link that no longer matches its own. Two links a second
# apart are told apart by the inode; two within one second, from a second
# installer running at the same moment, are not.
launcher_identity() {
  stat -c '%i %Y %N' -- "$launcher" 2>/dev/null
}

# Records the command an install left at the launcher path, for the retry that
# has to reclaim it. Only npm's command for the agent is ever recorded, and only
# as the exact link standing there now. Run from the exit trap, because an
# install can end between npm publishing its command and the installer
# returning -- a signal does exactly that -- and the paths that handle a failing
# installer never run then.
record_interrupted_install() {
  if npm_owns_launcher && mkdir -p "$(dirname "$install_pending")" &&
    launcher_identity >"$install_pending"; then
    return 0
  fi

  # There is nothing to reclaim, or the record could not be written. Either way
  # the next run must find no claim: a retry refused costs a message, and a
  # claim over a command this install did not publish costs the user theirs.
  rm -f -- "$install_pending"
  return 0
}

# Whether npm's command for the agent holds the launcher path because an install
# this command started never finished. An install of ours that was cut short
# after npm published its command leaves exactly the link a user's own
# `npm install -g wasmedge-agent` leaves, so the link cannot tell the two apart
# and the record is what does -- naming the command that install published, not
# merely that one ran. Anything else at that path is the user's own, and a file
# this command did not write is never installed over.
omarchy_install_interrupted() {
  local recorded

  [[ -f $install_pending ]] || return 1
  npm_owns_launcher || return 1

  recorded=$(cat "$install_pending" 2>/dev/null) || return 1
  [[ -n $recorded && $(launcher_identity) == "$recorded" ]]
}

# Puts a file that was moved off the launcher path back, or drops it once it is
# no longer wanted. Idempotent, so it is safe on every exit.
#
# Never over whatever now holds the launcher path. After a successful install
# that is the agent npm created, and a user's own file could have arrived while
# the install ran; either way it is what wasmedge-agent resolves to now, and it
# is not ours to displace. link() is what enforces that, for the reason
# write_launcher publishes with it: it refuses an occupied destination in the
# kernel, so nothing that arrives while this runs is replaced either. It links a
# symbolic link itself rather than what it resolves to, so one that was displaced
# goes back naming exactly what it named, dangling or not.
restore_displaced() {
  local displaced=$1

  [[ -e $displaced || -L $displaced ]] || return 0

  if ln -- "$displaced" "$launcher" 2>/dev/null; then
    rm -f -- "$displaced"
    return 0
  fi

  # An unoccupied launcher path here is link() failing for its own reasons, and
  # that is this function failing.
  if [[ ! -e $launcher && ! -L $launcher ]]; then
    return 1
  fi

  # The path is taken and the copy has nowhere to go. Drop it when this command
  # wrote it. Anything else was displaced by a move that lost the race its
  # ownership test leaves open, and deleting it would lose the very file this
  # command exists to leave alone -- so say where it is and leave it there.
  if omarchy_wrote "$displaced"; then
    rm -f -- "$displaced"
    return 0
  fi

  echo "$displaced is not a launcher this command wrote, and $launcher is taken." >&2
  echo "It was moved off the launcher path and left there. Move it back or remove it." >&2
}

# Whether the launcher has to step out of the install's way: npm's global prefix
# is the launcher's own directory, so the command npm creates wants the path the
# launcher holds, and npm refuses to write over a file it did not create.
launcher_must_step_aside() {
  npm_wants_launcher_path && omarchy_owns_launcher
}

# Downloads the agent's own installer and runs it unattended. Its output goes to
# the terminal and to a log, which is what makes a failure readable after a
# floating terminal has closed.
install_runtime() {
  local script status=0

  mkdir -p "$(dirname "$install_log")"
  script=$(mktemp) || return 1

  # To a file and then run, rather than piped into a shell: a pipe runs whatever
  # arrived before the connection broke, and a file either downloaded or did not.
  if ! curl -fsSL "$installer_url" -o "$script"; then
    rm -f "$script"
    echo "Could not download the WasmEdge Agent installer from $installer_url" >&2
    return 1
  fi

  # --yes is the installer's unattended mode: every prompt takes its default,
  # which is to install. The sentinel is exported for that run alone, and the
  # launcher reads it to know it is already inside this install and must not ask
  # for another one.
  OMARCHY_WASMEDGE_AGENT_INSTALLING=1 sh "$script" --yes 2>&1 | tee -a "$install_log" || status=$?
  rm -f "$script"

  return "$status"
}

case "$mode" in
  "")
    # A user who installed their own agent is not an error state, and the
    # resolution rule already runs their binary.
    if foreign_launcher; then
      exit 0
    else
      write_launcher
    fi
    ;;
  --now)
    # A command npm created for the agent's own package holds the launcher's
    # path on any machine whose global prefix is ~/.local, and it gets there two
    # ways: an install of this command's that was cut short after npm published
    # it, and a user's own `npm install -g`. Refusing the first would strand the
    # state a retry exists for -- that install takes the launcher with it, since
    # the copy moved aside is dropped when the path it would return to is
    # occupied, and nothing would ever run the idempotent installer again.
    # Installing over the second would write over an installation this command
    # did not make. The link is the same either way, so the record of an
    # unfinished install is what separates them.
    if foreign_launcher && ! omarchy_install_interrupted; then
      # Not ours to replace. A working one is what the default agent will run,
      # and a broken one is the user's to fix.
      if runtime_ready; then
        exit 0
      else
        echo "$launcher was not installed by Omarchy, and the WasmEdge Agent runtime is not ready." >&2
        echo "Fix or remove it, then run omarchy-install-wasmedge-agent --now again." >&2
        exit 1
      fi
    fi

    # Written before the install, so a failed install leaves a launcher that can
    # try again rather than a machine with no wasmedge-agent at all.
    write_launcher

    # The aside path is a fixed name, and the move onto it is a rename, which
    # replaces what it finds. Anything there this command did not write was left
    # by a restore that had nowhere to put it back, and moving over it would
    # destroy the very file that restore went out of its way to keep. Refused
    # before the trap below is armed, because nothing has been displaced yet.
    if launcher_must_step_aside &&
      [[ -e $launcher_aside || -L $launcher_aside ]] &&
      ! omarchy_wrote "$launcher_aside"; then
      echo "$launcher_aside was not written by Omarchy, and the WasmEdge Agent install needs that path." >&2
      echo "Move it out of that directory or remove it, then run omarchy-install-wasmedge-agent --now again." >&2
      exit 1
    fi

    # Everything this command owes the machine on the way out, in the one place
    # every exit runs -- an error, a refusal, or a signal that ends the shell
    # mid-install. What was moved aside goes back if the path is free, and what
    # npm published is recorded if it holds the path instead. An install cut
    # short after npm published has to stay retryable however it was cut short,
    # and a signal reaches neither failure path below.
    trap 'restore_displaced "$launcher_aside"; record_interrupted_install' EXIT

    # When npm's global prefix is the launcher's own directory, the launcher
    # occupies the exact path the install needs, and npm refuses to write over
    # it. Move ours out of the way for the duration of the install, and the trap
    # puts it back unless the install produced something better.
    #
    # Nothing foreign reaches here: the foreign_launcher test above exits first,
    # and omarchy_owns_launcher asks again at this point.
    if launcher_must_step_aside; then
      # Renaming a script that is running is safe: the rename keeps the inode
      # and the shell keeps its open descriptor. That matters, because the
      # launcher itself is what usually calls --now.
      if ! mv -fT -- "$launcher" "$launcher_aside"; then
        echo "Could not move $launcher aside for the WasmEdge Agent install." >&2
        exit 1
      fi
    fi

    if ! install_runtime; then
      echo "The WasmEdge Agent install failed. The log is at $install_log" >&2
      echo "Run omarchy-install-wasmedge-agent --now again to retry." >&2
      exit 1
    fi

    if ! runtime_ready; then
      echo "The WasmEdge Agent install finished, and the runtime is still not ready." >&2
      echo "The log is at $install_log" >&2
      exit 1
    fi

    # The runtime answers ready, so nothing is left to put right: the copy moved
    # aside is no longer wanted, and nothing at the launcher path is this
    # command's to reclaim. Disarmed first, so the trap cannot record the
    # command a finished install left as though it were unfinished work.
    trap - EXIT
    restore_displaced "$launcher_aside"
    rm -f -- "$install_pending"
    ;;
  --owns)
    if omarchy_owns_launcher; then
      exit 0
    else
      exit 1
    fi
    ;;
  --check)
    if runtime_ready; then
      exit 0
    else
      exit 1
    fi
    ;;
  *)
    echo "Usage: omarchy-install-wasmedge-agent [--check|--now|--owns]" >&2
    exit 2
    ;;
esac
